# ============================================================================
# 面必过全量环境变量模板
# 复制为 .env 后使用；不要提交真实密码、API Key 或浏览器登录目录。
# 模型聊天 API Key 与 Fast/Reasoning Pool 在前端「设置 → 模型配置」中维护。
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent_interview
POSTGRES_PASSWORD=change_me
POSTGRES_DB=agent_interview
DATABASE_URL=postgresql://agent_interview:change_me@localhost:5432/agent_interview

# ----------------------------------------------------------------------------
# Redis、任务队列与单用户运行锁
# ----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# 标准全量配置保持 true；false 仅用于单进程排障。
TASK_QUEUE_ENABLED=true
# 使用 Fernet.generate_key() 生成；API 和 Worker 必须完全一致。
TASK_PAYLOAD_ENCRYPTION_KEY=
AGENT_RUN_LOCK_TTL_SECONDS=600
# 用户手动重试与中断恢复共享此上限。
AGENT_RUN_MAX_ATTEMPTS=3
# queued/retrying 长时间未领取或 running 无心跳时，后台恢复循环会自动重新投递。
AGENT_RUN_STALE_SECONDS=1800
AGENT_RUN_HEARTBEAT_SECONDS=30
# 单个 Worker 最多并行 5 个岗位资产任务；其他 LLM 任务仍受单任务门禁保护。
AGENT_RUN_WORKER_THREADS=5
AGENT_RUN_CANCEL_POLL_SECONDS=2
AGENT_RUN_RECOVERY_INTERVAL_SECONDS=60
# 交互式简历生成会话在 PostgreSQL 中保留的时间。
RESUME_GENERATION_SESSION_TTL_HOURS=24

# ----------------------------------------------------------------------------
# Web/API
# ----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
# 全容器部署通过 Nginx 同源访问 API；本地前端直连后端时改为 http://localhost:8000。
NEXT_PUBLIC_API_URL=/api
# Docker Compose 会在 API/Worker 启动前执行迁移，因此全容器部署保持 false。
# 本地开发保持 true；需要严格验证 Alembic 迁移链时设为 false。
AUTO_CREATE_TABLES=true

# ----------------------------------------------------------------------------
# LLM 网关、模型池与请求限制
# 注意：具体模型成员由前端配置，不使用 FAST_LLM_* / SMART_LLM_* 环境变量。
# ----------------------------------------------------------------------------
LLM_REQUEST_TIMEOUT_SECONDS=45
# 同一任务跨重试/fallback 的总时间预算；TASK_DEADLINE_ENABLED=false 时仅供已显式迁移流程使用。
LLM_TASK_TIMEOUT_SECONDS=90
# 剩余时间低于此值时不再启动新的 attempt 或备用模型。
LLM_MIN_ATTEMPT_TIMEOUT_SECONDS=2
LLM_MAX_TOKENS=8000
# 只用于安全观测的 token 粗估，不替代供应商返回的实际 usage。
LLM_ESTIMATED_CHARS_PER_TOKEN=4
# 基础设施默认保持兼容；业务 Agent 分批迁移并验收后再全局开启。
TASK_DEADLINE_ENABLED=false
# JSON 映射，可按 Agent 覆盖上下文预算开关，例如 {"interview":true,"voice_interview":false}。
AGENT_CONTEXT_BUDGET_FLAGS={}
# 面试 Planner 的用户阻塞链路总预算；超时后立即使用本地题目兜底。
INTERVIEW_PLAN_TIMEOUT_SECONDS=20
# 面试报告原始 QA 超过该字符数后按块提取逐题证据，再汇总画像和短板。
INTERVIEW_REPORT_QA_CHAR_BUDGET=12000
INTERVIEW_REPORT_CHUNK_SIZE=5
INTERVIEW_REPORT_TASK_TIMEOUT_SECONDS=180
# Resume Workspace、交互式生成、岗位资产与画像各自共享的任务总预算。
RESUME_WORKSPACE_TASK_TIMEOUT_SECONDS=240
RESUME_GENERATION_TASK_TIMEOUT_SECONDS=240
JOB_ASSETS_TASK_TIMEOUT_SECONDS=240
ABILITY_PROFILE_TASK_TIMEOUT_SECONDS=60
# 素材与项目改写的独立输入预算。
RESUME_MATERIAL_MAX_ITEMS=8
RESUME_MATERIAL_ITEM_MAX_CHARS=1200
PROJECT_REWRITE_PROJECT_MAX_CHARS=5000
PROJECT_REWRITE_JD_MAX_CHARS=2500
# 外部 embedding/vector/mem0 调用独立超时；失败后降级为空结果。
EMBEDDING_TIMEOUT_SECONDS=8
VECTOR_SEARCH_TIMEOUT_SECONDS=5
MEM0_SEARCH_TIMEOUT_SECONDS=5
MEM0_ADD_TIMEOUT_SECONDS=5
API_CONFIG_VALIDATION_TIMEOUT_SECONDS=10
# 成员连续失败达到阈值后进入冷却，冷却期间由同池其他模型承接请求。
LLM_POOL_FAILURE_THRESHOLD=2
LLM_POOL_COOLDOWN_SECONDS=60
# 多 API/Worker 共享轮询、冷却和并发计数；Redis 不可用时自动降级到进程内。
LLM_POOL_REDIS_ENABLED=true
LLM_POOL_INFLIGHT_TTL_SECONDS=600
# 个人本地模式允许 Ollama/vLLM/LM Studio；公开部署时应设为 false。
ALLOW_PRIVATE_MODEL_BASE_URLS=true

# ----------------------------------------------------------------------------
# Guardrails AI 本地安全校验
# 只使用仓库内置 validator：不下载 Hub validator、不上传简历/JD、不启用 vendor telemetry。
# 关闭仅用于本地排障；生产建议保持 true + fail closed。
# ----------------------------------------------------------------------------
GUARDRAILS_ENABLED=true
GUARDRAILS_FAIL_CLOSED=true
GUARDRAILS_MAX_UNTRUSTED_CONTEXT_CHARS=20000

# ----------------------------------------------------------------------------
# RAG Embedding（OpenAI-compatible）
# 优先使用前端「设置 → RAG / 长期记忆模型」；以下仅作服务端兜底。
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1536

# ----------------------------------------------------------------------------
# 面试 RAG 与有界 Agentic Retrieval
# ----------------------------------------------------------------------------
RAG_VECTOR_ENABLED=true
# off=关闭；shadow=运行但不替换旧结果；active=仅质量改善时采用。
RAG_AGENTIC_MODE=shadow
RAG_AGENTIC_MAX_ROUNDS=2
RAG_AGENTIC_MAX_QUERIES=4
RAG_AGENTIC_MIN_SCORE=0.30
RAG_AGENTIC_MIN_EVIDENCES=2
RAG_AGENTIC_MIN_SOURCE_TYPES=2
RAG_WEIGHT_VECTOR=0.45
RAG_WEIGHT_TEXT=0.25
RAG_WEIGHT_SOURCE=0.20
RAG_WEIGHT_FRESHNESS=0.10

# ----------------------------------------------------------------------------
# 文件解析
# ----------------------------------------------------------------------------
FILE_PARSE_TIMEOUT_SECONDS=30

# ----------------------------------------------------------------------------
# 语音面试运行默认值
# API Key、Base URL 与模型优先使用前端 Voice 通道。
# ----------------------------------------------------------------------------
VOICE_MODEL=qwen3-omni-flash-2025-12-01
VOICE_NAME=Cherry
VOICE_INPUT_FORMAT=wav
VOICE_OUTPUT_FORMAT=wav
# 每轮只发送近期原文和更早历史的确定性摘要；音频限制在模型调用前校验。
VOICE_HISTORY_MAX_CHARS=5000
VOICE_RECENT_MESSAGE_COUNT=8
VOICE_AUDIO_MAX_BYTES=8000000
VOICE_AUDIO_MAX_DURATION_SECONDS=120
VOICE_FIRST_CHUNK_TIMEOUT_SECONDS=12
# JSON 对象；仅配置确认需要修正的识别词。
VOICE_TRANSCRIPT_TERM_FIXES={}
# 示例：VOICE_TRANSCRIPT_TERM_FIXES={"lang graph":"LangGraph","拉姆达":"Lambda"}

# ----------------------------------------------------------------------------
# Langfuse Agent 可观测性
# ----------------------------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 按环境/版本聚合 Trace，并通过采样控制成本。
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=local
LANGFUSE_SAMPLE_RATE=1.0
# 启用 Langfuse Prompt Management，失败时自动回退本地 Prompt。
LANGFUSE_PROMPT_MANAGEMENT_ENABLED=false
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300
# 离线评估/DeepEval 结果写入 Langfuse Scores。
LANGFUSE_EVAL_REPORTING_ENABLED=false

# ----------------------------------------------------------------------------
# BOSS 现有标签页桥接
# 当前页采集和岗位详情导航由 macOS 宿主机上的 browser_automation_service
# 通过 Apple 事件复用用户已经登录的 Edge/Chrome 标签页；主后端可在 Docker 中调用。
# ----------------------------------------------------------------------------
BROWSER_AUTOMATION_SERVICE_URL=http://host.docker.internal:8765
# 至少 32 字符，API 与宿主机自动化服务必须一致；用 openssl rand -hex 32 生成。
BROWSER_AUTOMATION_SERVICE_TOKEN=
BROWSER_AUTOMATION_REQUEST_TIMEOUT_SECONDS=300
# 以下 3 个变量仅供 backend/scripts/run-browser-automation-service.sh 读取；默认只监听本机。
BROWSER_AUTOMATION_SERVICE_HOST=127.0.0.1
BROWSER_AUTOMATION_SERVICE_PORT=8765
BROWSER_AUTOMATION_CLEAR_PROXY_ENV=true
# 现有标签页桥接默认渠道；前端岗位中心也可在 msedge/chrome 间显式切换。
BOSS_BROWSER_CHANNEL=msedge
# 现有标签页导入采用固定保守节奏；同一用户两次提交至少间隔 180 秒，每小时最多 4 次。
BOSS_CAPTURE_MIN_INTERVAL_SECONDS=180
BOSS_CAPTURE_MAX_PER_HOUR=4
# 搜索提交前动作间隔与岗位列表检查间隔；检查间隔硬下限为 5 秒。
BOSS_CAPTURE_ACTION_DELAY_SECONDS=2
BOSS_CAPTURE_POLL_INTERVAL_SECONDS=5
# DOM 单次最多处理 20 个候选卡片；请求值和环境值都不能突破该上限。
BOSS_CAPTURE_MAX_CANDIDATE_CARDS=20

# ----------------------------------------------------------------------------
# mem0 长期记忆
# 前端携带 mem0_llm/mem0_embedder 时可启用；以下仅作服务端兜底与 pgvector 配置。
# ----------------------------------------------------------------------------
MEM0_ENABLED=false
MEM0_VECTOR_PROVIDER=pgvector
MEM0_PGVECTOR_COLLECTION=mem0_memories
MEM0_PGVECTOR_HOST=localhost
MEM0_PGVECTOR_PORT=5432
MEM0_PGVECTOR_DBNAME=agent_interview
MEM0_PGVECTOR_USER=agent_interview
MEM0_PGVECTOR_PASSWORD=change_me

# mem0 记忆提取模型
MEM0_LLM_PROVIDER=openai
MEM0_LLM_MODEL=deepseek-v4-flash
MEM0_LLM_API_KEY=
MEM0_LLM_BASE_URL=https://api.deepseek.com/v1

# mem0 语义检索模型
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDER_MODEL=text-embedding-v4
MEM0_EMBEDDER_API_KEY=
MEM0_EMBEDDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEM0_EMBEDDING_DIMS=1536

MEM0_SEARCH_LIMIT=5
MEM0_CONTEXT_CHAR_LIMIT=1200
# 长期记忆默认保留天数；到期记忆不再参与检索。
MEM0_RETENTION_DAYS=180
MEM0_BACKGROUND_WRITE=true

# ----------------------------------------------------------------------------
# Agent 评测中心与 Eval Harness（默认关闭；评测环境禁止真实外部副作用）
# ----------------------------------------------------------------------------
EVALUATION_CENTER_ENABLED=false
EVALUATION_RUNS_ENABLED=false
EVALUATION_LANGFUSE_REPORTING_ENABLED=false
EVALUATION_ONLINE_SAMPLING_ENABLED=false
# off: 不检查；warn: 允许发布但返回审计告警；enforce: 必须有通过的 Gate Result。
EVALUATION_RELEASE_GATE_MODE=off
EVALUATION_MAX_CONCURRENCY=4
EVALUATION_DEFAULT_MAX_BUDGET_USD=5.0
